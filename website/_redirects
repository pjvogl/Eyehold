# Cloudflare Pages redirects for eyehold.com.
# Eyehold Credits accounts live on a separate host (account.eyehold.com, the eyehold-cloud service). People
# who look for "login" on the marketing site type these paths and used to land on the 404 page (issue #76).
/login       https://account.eyehold.com/login 302
/log-in      https://account.eyehold.com/login 302
/signin      https://account.eyehold.com/login 302
/sign-in     https://account.eyehold.com/login 302
/signup      https://account.eyehold.com/login 302
/sign-up     https://account.eyehold.com/login 302
/register    https://account.eyehold.com/login 302
/account     https://account.eyehold.com/account 302
/account/*   https://account.eyehold.com/account/:splat 302
